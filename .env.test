NODE_ENV=test
SESSION_DRIVER=memory
DB_DATABASE=fabrmatch_test
ADMIN_2FA_REQUIRED=false
EMAIL_VERIFICATION_REQUIRED=true
MATCHING_AUTO_OFFER=true
PORT=3390
# browser tests click right after load; SSR is checked by `npm run ssr:check` instead
INERTIA_SSR=false

# Legacy payout suites exercise the marketplace path; sales-model-B specs set the model explicitly
SALES_MODEL=marketplace
