    {
      "id": "docs_fabrmatch_fullstack_prd_order_state_machine",
      "label": "Order State Machine",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 6",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All order state transitions must go through OrderStateMachine with DB transaction + audit_log to ensure consistency, traceability, and prevent invalid state transitions."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_matching_algorithm",
      "label": "Fair Matching Algorithm",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "4-step algorithm: eligibility filter (hard constraints), scoring (quality 35%, on-time 25%, distance 20%, load-balance 20%), new manufacturer exploration quota (20% of rounds go to new makers to ensure >80% get first job in 30 days), single offer with 30min timeout up to 5 rounds. Pure function with injected RNG for deterministic testing."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_pricing_engine",
      "label": "Pricing Engine",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 7",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Integer minor units to avoid floating-point rounding errors. Formula: material cost + machine cost -> manufacturer share -> platform commission -> base cost + seller margin = retail price. Reference price table provides consistent buyer-facing pricing while RFQ handles competitive bidding."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_ip_protection",
      "label": "IP Protection & Trust Tiers",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 10",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "4-tier trust system (0-3) controls file access duration and download limits. Tier 0 (new): 24h/2 downloads. Tier 3 (partner): cache allowed. Access only via file_access_grants with signed URLs. Prevents IP theft while allowing production workflow."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_anonymity",
      "label": "Anonymity & Platform Bypass Prevention",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 9",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Manufacturer identity hidden from seller/buyer via public_alias. Transformer layer enforces field-level access: seller variant has no manufacturer field, manufacturer variant has only shipping fields of buyer. Shipping label shows 'Fabrmatch Fulfillment'. Prevents direct deals that bypass platform."
    },
