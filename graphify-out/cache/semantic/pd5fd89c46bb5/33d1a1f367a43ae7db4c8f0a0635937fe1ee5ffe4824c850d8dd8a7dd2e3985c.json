    {
      "id": "docs_fabrmatch_fullstack_prd_double_entry_ledger",
      "label": "Double-Entry Ledger",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 11",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All money movements recorded as double-entry ledger_entries (sum = 0). Daily reconciliation job compares with provider reports. Accounts: buyer_escrow, platform_fee, manufacturer_payable, seller_payable, refund. Prevents accounting errors and enables audit trail."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_domain_services",
      "label": "Domain Service Architecture (12 domains)",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Business logic in app/services/<domain>/ with thin controllers (validate -> service -> transform). 12 domains: identity, manufacturing, catalog, files, pricing, orders, matching, payments, disputes, integrations, rfq, admin. Follows AdonisJS convention of file-type folders while grouping logic by business domain."
    },
