    {
      "id": "docs_fabrmatch_fullstack_prd_encryption",
      "label": "Sensitive Field Encryption (AES-256-GCM)",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Sensitive fields (address, IBAN, TCKN, tokens) encrypted at rest with aes256gcm. Deterministic aessiv variant available for searchable encrypted fields like email. Protects PII in case of database breach."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_transformer_pattern",
      "label": "Transformer Pattern (role-based serialization)",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 2, 9",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "v7 Transformers (BaseTransformer) enforce field-level access rules in one typed location. Critical for manufacturer anonymity: OrderTransformer seller variant excludes all manufacturer fields, manufacturer variant includes only shipping address fields of buyer."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_integer_money",
      "label": "Integer Minor Unit Money Pattern",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All monetary values stored as integers in smallest currency unit (kurus/cent) plus ISO 4217 currency code. No JS float/decimal arithmetic. Prevents rounding errors in financial calculations."
    },
    {
      "id": "docs_fabrmatch_fullstack_prd_exploration_quota",
      "label": "New Manufacturer Exploration Quota",
      "file_type": "rationale",
      "source_file": "docs/FABRMATCH_FULLSTACK_PRD.md",
      "source_location": "Section 8 Step 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "20% of matching rounds probabilistically offer to new manufacturers (joined <30 days, <3 completed jobs) to ensure >80% of new makers receive at least 1 order in first 30 days. Exploration limited to low-complexity jobs. Tracked via match_offers.is_exploration flag."
    }
