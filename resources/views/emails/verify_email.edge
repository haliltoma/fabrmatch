<!DOCTYPE html>
<html lang="{{ tr ? 'tr' : 'en' }}">
  <body style="margin:0;padding:0;background:#f5f2ec;font-family:'Instrument Sans',Helvetica,Arial,sans-serif;color:#15181c;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f2ec;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
            <tr>
              <td style="padding:0 0 20px 0;font-size:20px;font-weight:600;letter-spacing:-0.02em;">
                <span style="display:inline-block;width:22px;vertical-align:middle;">
                  <span style="display:block;height:4px;background:#15181c;margin-bottom:3px;"></span>
                  <span style="display:block;height:4px;width:80%;background:#f0501e;margin-bottom:3px;"></span>
                  <span style="display:block;height:4px;width:60%;background:#15181c;"></span>
                </span>
                &nbsp;Fabrmatch
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #dedad3;border-radius:10px;padding:28px;">
                <h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.25;letter-spacing:-0.02em;">{{ tr ? 'E-postanı doğrula' : 'Verify your e-mail' }}</h1>
                <p style="margin:0 0 24px 0;font-size:16px;line-height:1.6;color:#363d45;">{{ tr ? 'Merhaba ' + (user.fullName || '') + ', sipariş vermek, itiraz açmak ve ödeme almak için adresini doğrula. Bağlantı 24 saat geçerlidir.' : 'Hi ' + (user.fullName || 'there') + ', confirm your address to place orders, open disputes and receive payouts. The link is valid for 24 hours.' }}</p>
                <a href="{{ verifyUrl }}" style="display:inline-block;background:#15181c;color:#f5f2ec;text-decoration:none;font-weight:600;font-size:15px;padding:12px 20px;border-radius:6px;">{{ tr ? 'E-postayı doğrula' : 'Verify e-mail' }}</a>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 4px 0 4px;font-size:12px;line-height:1.5;color:#6b737c;">
                {{ tr ? 'Fabrmatch hesabı oluşturmadıysan bu e-postayı yok sayabilirsin.' : 'If you did not create a Fabrmatch account you can ignore this e-mail.' }}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
