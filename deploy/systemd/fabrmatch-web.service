[Unit]
Description=Fabrmatch web (HTTP + scheduler)
After=network-online.target

[Service]
WorkingDirectory=%h/my-projects/fabrmatch/build
EnvironmentFile=%h/.config/fabrmatch/app.env
ExecStart=%h/.nvm/versions/node/v24.21.0/bin/node bin/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
