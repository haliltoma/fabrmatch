# Template: deploy/deploy.sh fills @APP_DIR@ and @NODE_BIN@ and installs it as a user unit
[Unit]
Description=Fabrmatch web (HTTP + scheduler)
After=network-online.target

[Service]
WorkingDirectory=@APP_DIR@/build
EnvironmentFile=%h/.config/fabrmatch/app.env
ExecStart=@NODE_BIN@ bin/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
