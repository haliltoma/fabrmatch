# Template: deploy/deploy.sh fills @APP_DIR@ and @NODE_BIN@ and installs it as a user unit
[Unit]
Description=Fabrmatch queue worker
After=network-online.target

[Service]
WorkingDirectory=@APP_DIR@/build
EnvironmentFile=%h/.config/fabrmatch/app.env
ExecStart=@NODE_BIN@ ace queue:work
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
