---
import { money } from '../lib/format';
import type { Product } from '../lib/store-data';

type Props = { product: Product };
const { product } = Astro.props;

const prices = product.variants.map((v) => v.calculated_price).filter((p) => p !== null);
const cheapest = prices.length ? prices.reduce((min, p) => (p!.calculated_amount < min!.calculated_amount ? p : min)) : null;
---

<a href={`/urun/${product.handle}`} class="fm-product-card">
  <div class="fm-product-card__media">
    {product.thumbnail && <img src={product.thumbnail} alt={product.title} loading="lazy" />}
    <span class="fm-3d-badge">
      <i class="ti ti-rotate-3d" aria-hidden="true"></i>3D
    </span>
  </div>
  <div class="fm-product-card__body">
    <h3>{product.title}</h3>
    <span class="fm-small fm-muted">{product.categories[0]?.name}</span>
    {cheapest && (
      <span class="fm-product-card__price">{money(cheapest.calculated_amount, cheapest.currency_code)}'den</span>
    )}
  </div>
</a>
