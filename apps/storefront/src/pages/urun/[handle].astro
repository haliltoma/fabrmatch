---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VariantOfferPicker from '../../components/VariantOfferPicker';
import { listAllProducts, getDefaultRegion } from '../../lib/store-data';

export async function getStaticPaths() {
  const products = await listAllProducts();
  return products.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

const { product } = Astro.props;
const region = await getDefaultRegion();
const profile = product.metadata?.print_profile;
const totalWeight = profile ? profile.part_weight_g + profile.support_weight_g : 0;
const usedPercent = profile && totalWeight > 0 ? (profile.part_weight_g / totalWeight) * 100 : 100;
---

<BaseLayout title={product.title} description={product.description ?? undefined}>
  <div class="fm-page">

    <!-- Breadcrumb -->
    <p class="fm-breadcrumbs">
      <a href="/"><i class="ti ti-home" aria-hidden="true"></i></a>
      /
      {product.categories[0] ? (
        <a href={`/kategori/${product.categories[0].handle}`}>{product.categories[0].name}</a>
      ) : (
        <a href="/urunler">ürünler</a>
      )}
      / <span>{product.title}</span>
    </p>

    <div class="fm-pdp">

      <!-- Galeri -->
      <div class="fm-pdp__gallery">
        {product.thumbnail
          ? <img src={product.thumbnail} alt={product.title} />
          : (
            <span class="fm-pdp__gallery-placeholder" aria-hidden="true">
              <i class="ti ti-cube"></i>
            </span>
          )
        }
        {profile && (
          <span class="fm-3d-badge">
            <i class="ti ti-rotate-3d" aria-hidden="true"></i>3D
          </span>
        )}
      </div>

      <!-- Bilgi paneli -->
      <div class="fm-pdp__info">
        {product.categories[0] && (
          <span class="fm-pdp__category">{product.categories[0].name}</span>
        )}
        <h1>{product.title}</h1>
        {product.description && (
          <p class="fm-pdp__description">{product.description}</p>
        )}

        <VariantOfferPicker client:load product={product} regionId={region.id} />

        <!-- Malzeme verimliliği — 06 §3: her zaman görünür -->
        {profile && (
          <div class="fm-pdp__material">
            <div class="fm-pdp__material-head">
              <i class="ti ti-leaf" aria-hidden="true"></i>
              <span>Malzeme verimliliği</span>
            </div>
            <div
              class="fm-material-bar"
              role="img"
              aria-label={`Malzemenin yüzde ${Math.round(usedPercent)} kadarı ürüne gidiyor`}
            >
              <div class="fm-material-bar__used" style={`width:${usedPercent}%`}></div>
              <div class="fm-material-bar__waste" style={`width:${100 - usedPercent}%`}></div>
            </div>
            <div class="fm-material-legend">
              <div><strong>{profile.slicer}</strong>slicer</div>
              <div><strong>{profile.part_weight_g} g</strong>ürün ağırlığı</div>
              <div><strong>{profile.support_weight_g} g</strong>destek ve atık</div>
              <div><strong>{profile.print_time_minutes} dk</strong>tahmini baskı süresi</div>
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</BaseLayout>
