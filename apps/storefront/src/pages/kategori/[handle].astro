---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductsWithFilter from '../../components/ProductsWithFilter';
import { listAllProducts, listLeafCategories } from '../../lib/store-data';

export async function getStaticPaths() {
  const [categories, products] = await Promise.all([listLeafCategories(), listAllProducts()]);
  return categories.map((category) => ({
    params: { handle: category.handle },
    props: {
      category,
      products: products.filter((product) => product.categories.some((c) => c.id === category.id)),
    },
  }));
}

const { category, products } = Astro.props;
---

<BaseLayout title={category.name}>
  <div class="fm-page">
    <p class="fm-breadcrumbs">
      <a href="/">anasayfa</a> / <a href="/urunler">tüm ürünler</a> / {category.name}
    </p>
    <h1>{category.name}</h1>

    <ProductsWithFilter
      products={products}
      categories={[]}
      hideCategoryFilter={true}
      client:load
    />
  </div>
</BaseLayout>
