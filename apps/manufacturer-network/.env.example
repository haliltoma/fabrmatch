# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Database (Sistem B'nin kendi veritabanı)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=fabrmatch_network

# Queue
QUEUE_DRIVER=redis

# Sistem A sözleşmesi (docs/09-API-SOZLESMESI.md)
SISTEM_A_URL=http://localhost:9000
SISTEM_A_INBOUND_API_KEY=
FABRMATCH_WEBHOOK_SECRET=

# Geometri servisi (services/geometry)
GEOMETRY_URL=http://127.0.0.1:8000
GEOMETRY_SERVICE_KEY=