# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fabrmatch_dev

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / Minio
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_BUCKET=fabrmatch
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# Mail
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Payments: fake (dev/test only) | iyzico
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=change-me
ADMIN_2FA_REQUIRED=true
